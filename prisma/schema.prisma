generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum EstadoPedido {
  Pendiente
  Pagado
  EnProduccion
  ListoParaEnvio
  Enviado
  Entregado
  Cancelado
}

enum EstadoPago {
  PendienteTransferencia
  EnRevision
  Pagado
  Rechazado
  Reembolsado
}

enum MetodoEnvio {
  CorreosSucursal
  StarkenPorPagar
  MetroL1
}

enum EstadoEnvio {
  Preparando
  Despachado
  EnTransito
  Entregado
  Devuelto
}

enum EstadoLote {
  Solicitado
  EnProgreso
  Completado
  Recibido
  Cancelado
}

enum TipoMovimiento {
  Entrada
  Salida
  Ajuste
}

enum CanalVenta {
  Web
  Instagram
  WhatsApp
  Feria
  Otro
}

// ============================================================
// Usuarios y clientes
// ============================================================

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String
  rol               String          @default("Propietario")
  totpSecret        String?
  totpEnabled       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  stockMovements    StockMovement[]
  auditLogs         AuditLog[]
  paymentsRevisados Payment[]
}

model Customer {
  id                  String       @id @default(cuid())
  nombre              String
  email               String       @unique
  passwordHash        String?
  telefono            String?
  direccion           String?
  rut                 String?
  instagram           String?
  notas               String?
  image               String?
  emailVerified       DateTime?
  googleId            String?      @unique
  backstagePass       Boolean      @default(false)
  backstagePassExpira DateTime?
  fechaRegistro       DateTime     @default(now())
  totalGastado        Decimal      @default(0)
  orders              Order[]
  cart                Cart?
  addresses           Address[]
  favorites           Favorite[]
  reviews             Review[]
  emailTokens         EmailToken[]
}

/// Direcciones guardadas del cliente (envío rápido en próximas compras).
model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  etiqueta    String? // "Casa", "Trabajo"
  nombre      String
  telefono    String
  calle       String
  numero      String
  comuna      String
  region      String
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// Tokens de verificación de email y recuperación de contraseña.
model EmailToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  tipo       String // "verify" | "reset"
  expiraAt   DateTime
  usadoAt    DateTime?
  createdAt  DateTime  @default(now())
}

// ============================================================
// Carrito (anónimo o de cliente)
// ============================================================

model Cart {
  id         String     @id @default(cuid())
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String?    @unique // carrito anónimo, cookie httpOnly
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cantidad  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

// ============================================================
// Catálogo
// ============================================================

/// Drop / colección mensual (4-6 modelos, vigencia limitada).
model Collection {
  id               String    @id @default(cuid())
  nombre           String
  slug             String    @unique
  descripcion      String?
  fechaLanzamiento DateTime?
  fechaCierre      DateTime?
  activa           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  products         Product[]
}

model Product {
  id            String           @id @default(cuid())
  nombre        String
  slug          String           @unique
  nombreSlug    String           @unique // legado, se mantiene por compatibilidad de datos históricos
  descripcion   String
  disenoUrl     String // legado: imagen principal antes de ProductImage
  artista       String
  temporada     String
  precio        Decimal          @default(0)
  costoUnitario Decimal          @default(0)
  activo        Boolean          @default(true)
  collectionId  String?
  collection    Collection?      @relation(fields: [collectionId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ProductVariant[]
  images        ProductImage[]
  favorites     Favorite[]
  reviews       Review[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductVariant {
  id         String                @id @default(cuid())
  productId  String
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  talle      String
  color      String
  sku        String                @unique
  stock      Int                   @default(0)
  stockMin   Int                   @default(5)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  orderItems OrderItem[]
  movements  StockMovement[]
  cartItems  CartItem[]
  batchItems ProductionBatchItem[]
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId      String // el pedido entregado que habilita la reseña
  order        Order    @relation(fields: [orderId], references: [id])
  calificacion Int // 1-5
  comentario   String?
  fotoUrl      String?
  aprobada     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([customerId, orderId, productId])
}

// ============================================================
// Cupones
// ============================================================

model Coupon {
  id           String    @id @default(cuid())
  codigo       String    @unique
  tipo         String // "porcentaje" | "monto" | "envio_gratis"
  valor        Decimal   @default(0)
  montoMinimo  Decimal?
  usosMaximos  Int?
  usosActuales Int       @default(0)
  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  orders       Order[]
}

// ============================================================
// Pedidos y pagos
// ============================================================

model Order {
  id              String       @id @default(cuid())
  numero          Int          @unique @default(autoincrement())
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  subtotal        Decimal      @default(0)
  costoEnvio      Decimal      @default(0)
  descuento       Decimal      @default(0)
  total           Decimal
  estado          EstadoPedido @default(Pendiente)
  estadoPago      EstadoPago   @default(PendienteTransferencia)
  canal           CanalVenta   @default(Web)
  metodoEnvio     MetodoEnvio?
  notas           String?
  couponId        String?
  coupon          Coupon?      @relation(fields: [couponId], references: [id])
  envioNombre     String?
  envioTelefono   String?
  envioCalle      String?
  envioNumero     String?
  envioComuna     String?
  envioRegion     String?
  pagadoAt        DateTime?
  fechaCompromiso DateTime?
  pagoExpiraAt    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
  shipment        Shipment?
  payments        Payment[]
  reviews         Review[]
}

model OrderItem {
  id         String         @id @default(cuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  cantidad   Int
  precioUnit Decimal
  costoUnit  Decimal        @default(0) // snapshot del costo al momento de la venta, para margen
}

/// Comprobante de transferencia y su confirmación/rechazo.
model Payment {
  id                 String     @id @default(cuid())
  orderId            String
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  monto              Decimal
  banco              String?
  fechaTransferencia DateTime?
  referencia         String?
  comprobanteUrl     String?
  estado             EstadoPago @default(EnRevision)
  confirmadoPorId    String?
  confirmadoPor      User?      @relation(fields: [confirmadoPorId], references: [id])
  confirmadoAt       DateTime?
  createdAt          DateTime   @default(now())
}

// ============================================================
// Proveedores, insumos y producción
// ============================================================

model Supplier {
  id           String            @id @default(cuid())
  nombre       String
  contacto     String // legado
  email        String?
  telefono     String?
  rut          String?
  tipo         String? // "taller" | "insumos" | "otro"
  leadTimeDias Int
  costoBase    Decimal
  calificacion Int               @default(3)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  batches      ProductionBatch[]
  materials    Material[]
}

model Material {
  id         String             @id @default(cuid())
  nombre     String
  unidad     String // "unidad", "metro", "litro", "kg"
  stock      Decimal            @default(0)
  costo      Decimal            @default(0)
  supplierId String?
  supplier   Supplier?          @relation(fields: [supplierId], references: [id])
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  movements  MaterialMovement[]
}

model MaterialMovement {
  id          String         @id @default(cuid())
  materialId  String
  material    Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  cantidad    Decimal
  tipo        TipoMovimiento
  origen      String
  descripcion String?
  createdAt   DateTime       @default(now())
}

model ProductionBatch {
  id             String                @id @default(cuid())
  supplierId     String
  supplier       Supplier              @relation(fields: [supplierId], references: [id])
  costoTotal     Decimal
  fechaPedido    DateTime              @default(now())
  fechaEstimada  DateTime
  fechaRecepcion DateTime?
  estado         EstadoLote            @default(Solicitado)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  items          ProductionBatchItem[]
}

model ProductionBatchItem {
  id            String          @id @default(cuid())
  batchId       String
  batch         ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant  @relation(fields: [variantId], references: [id])
  orderItemId   String? // vincula el lote a un ítem de pedido pagado (venta bajo pedido)
  cantidad      Int
  costoUnitario Decimal
}

model StockMovement {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  cantidad    Int
  tipo        TipoMovimiento
  origen      String
  descripcion String?
  createdAt   DateTime       @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entidad   String
  entidadId String
  accion    String
  payload   String?
  createdAt DateTime @default(now())
}

// ============================================================
// Envíos
// ============================================================

model Shipment {
  id             String       @id @default(cuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id])
  metodo         MetodoEnvio?
  trackingNumber String?
  transportista  String?
  costo          Decimal?
  sucursal       String?
  estacionMetro  String?
  horaEntrega    String?
  porPagar       Boolean      @default(false)
  fechaDespacho  DateTime?
  fechaEstimada  DateTime?
  fechaEntrega   DateTime?
  estado         EstadoEnvio  @default(Preparando)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ============================================================
// Marketing y configuración
// ============================================================

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Configuración editable de la tienda — fila única (id fijo "default").
model StoreSettings {
  id                  String   @id @default("default")
  razonSocial         String?
  rut                 String?
  direccionLegal      String?
  emailContacto       String?
  telefonoContacto    String?
  whatsapp            String?
  instagram           String?
  facebook            String?
  tiktok              String?
  horarioAtencion     String?
  bancoTitular        String?
  bancoRut            String?
  bancoNombre         String?
  bancoTipoCuenta     String?
  bancoNumeroCuenta   String?
  bancoEmail          String?
  costoEnvioCorreos   Decimal  @default(3000)
  plazoProduccionDias Int      @default(7)
  updatedAt           DateTime @updatedAt
}
