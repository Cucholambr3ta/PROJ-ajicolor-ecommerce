generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum EstadoPedido {
  Pendiente
  Pagado
  EnProduccion
  ListoParaEnvio
  Enviado
  Entregado
  Cancelado
}

enum EstadoPago {
  PendienteTransferencia
  EnRevision
  Pagado
  Rechazado
  Reembolsado
}

enum MetodoEnvio {
  CorreosSucursal
  StarkenPorPagar
  MetroL1
}

enum EstadoEnvio {
  Preparando
  Despachado
  EnTransito
  Entregado
  Devuelto
}

enum ResolucionDevolucion {
  Reembolso
  Cambio
}

enum EstadoLote {
  Solicitado
  EnProgreso
  Completado
  Recibido
  Cancelado
}

enum TipoMovimiento {
  Entrada
  Salida
  Ajuste
}

enum CanalVenta {
  Web
  Instagram
  WhatsApp
  Feria
  Otro
}

enum CategoriaProducto {
  Adulto
  Kids
}

/// Tipo de producto — qué es físicamente (no confundir con CategoriaProducto,
/// que es la audiencia Adulto/Kids). Determina si usa talles de ropa o una
/// sola variante por color (ver Product.usaTalles derivado en código).
enum TipoProducto {
  Polera
  Poleron
  Totebag
  Reloj
  Papeleria
}

enum EstadoCotizacion {
  Pendiente     // recién enviada por el cliente, sin revisar
  EnRevision    // el dueño la está evaluando
  Cotizada      // el dueño fijó un precio y respondió al cliente
  Aceptada      // el cliente confirmó, pasa a producción manual
  Rechazada
}

// ============================================================
// Usuarios y clientes
// ============================================================

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  passwordHash      String
  rol               String          @default("Propietario")
  totpSecret        String?
  totpEnabled       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  stockMovements    StockMovement[]
  auditLogs         AuditLog[]
  paymentsRevisados Payment[]
}

model Customer {
  id                  String       @id @default(cuid())
  nombre              String
  email               String       @unique
  passwordHash        String?
  telefono            String?
  direccion           String?
  rut                 String?
  instagram           String?
  notas               String?
  image               String?
  emailVerified       DateTime?
  googleId            String?      @unique
  backstagePass       Boolean      @default(false)
  backstagePassExpira DateTime?
  fechaRegistro       DateTime     @default(now())
  totalGastado        Decimal      @default(0)
  orders              Order[]
  cart                Cart?
  addresses           Address[]
  favorites           Favorite[]
  reviews             Review[]
  emailTokens         EmailToken[]
  cotizaciones        CotizacionPersonalizada[]
}

/// Direcciones guardadas del cliente (envío rápido en próximas compras).
model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  etiqueta    String? // "Casa", "Trabajo"
  nombre      String
  telefono    String
  calle       String
  numero      String
  comuna      String
  region      String
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// Tokens de verificación de email y recuperación de contraseña.
model EmailToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  tipo       String // "verify" | "reset"
  expiraAt   DateTime
  usadoAt    DateTime?
  createdAt  DateTime  @default(now())
}

// ============================================================
// Carrito (anónimo o de cliente)
// ============================================================

model Cart {
  id         String     @id @default(cuid())
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  token      String?    @unique // carrito anónimo, cookie httpOnly
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cantidad  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

// ============================================================
// Catálogo
// ============================================================

/// Paleta de colores de tela administrable desde /admin/colores — antes
/// vivía hardcodeada en el código (src/lib/kids.ts y ProductoDetailClient),
/// ahora el admin puede agregar colores nuevos sin deploy cuando el taller
/// consigue una tela nueva. ProductVariant.color sigue siendo texto libre
/// (match por nombre), esta tabla solo alimenta el selector del formulario
/// y el hex de los swatches.
model Color {
  id        String            @id @default(cuid())
  nombre    String
  hex       String
  categoria CategoriaProducto
  createdAt DateTime          @default(now())

  @@unique([nombre, categoria])
}

/// Drop / colección mensual (4-6 modelos, vigencia limitada).
model Collection {
  id               String    @id @default(cuid())
  nombre           String
  slug             String    @unique
  descripcion      String?
  fechaLanzamiento DateTime?
  fechaCierre      DateTime?
  activa           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  products         Product[]
}

model Product {
  id            String           @id @default(cuid())
  nombre        String
  slug          String           @unique
  nombreSlug    String           @unique // legado, se mantiene por compatibilidad de datos históricos
  descripcion   String
  disenoUrl     String // legado: foto completa de la polera ya puesta — fallback cuando no hay estampadoUrl
  artista       String
  temporada     String
  categoria     CategoriaProducto @default(Adulto)
  tipo          TipoProducto     @default(Polera)
  precio        Decimal          @default(0)
  costoUnitario Decimal          @default(0)
  activo        Boolean          @default(true)
  collectionId  String?
  collection    Collection?      @relation(fields: [collectionId], references: [id])
  // Ficha con mockup teñible por color (ver docs/SPEC-ficha-producto-mockup.md):
  // estampadoUrl es SOLO el diseño recortado (PNG transparente, sin la
  // polera) — si está presente, la ficha usa el mockup único
  // (public/productos/mockup/polera-base.png) teñido con el color elegido
  // + este estampado superpuesto en la zona configurada. Si es null, la
  // ficha sigue mostrando disenoUrl/ProductImage como hoy (fallback).
  estampadoUrl  String?
  // Zona del estampado sobre el mockup, en % (0-100) — mismo criterio que
  // PrendaZona.x2d/y2d/w2d/h2d del cotizador, pero fija por producto (no
  // por lado, ya que acá todas las variantes son la misma prenda base).
  estampadoX    Decimal?
  estampadoY    Decimal?
  estampadoW    Decimal?
  estampadoH    Decimal?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ProductVariant[]
  images        ProductImage[]
  colorImages   ProductColorImage[]
  favorites     Favorite[]
  reviews       Review[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  orden     Int      @default(0)
  createdAt DateTime @default(now())
}

/// Foto real por color (y lado, si el producto tiene frente y espalda) para
/// el selector de color de la ficha de producto — reemplaza la convención
/// vieja de archivos estáticos en public/productos/<color>/, que no se
/// puede subir desde el panel admin en producción (Vercel es read-only en
/// runtime). Subida real: bucket Supabase Storage "productos", igual que
/// ProductImage.
model ProductColorImage {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  lado      LadoPrenda @default(Frente)
  url       String
  createdAt DateTime   @default(now())

  @@unique([productId, color, lado])
}

model ProductVariant {
  id         String                @id @default(cuid())
  productId  String
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  talle      String
  color      String
  sku        String                @unique
  stock      Int                   @default(0)
  stockMin   Int                   @default(5)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  orderItems OrderItem[]
  movements  StockMovement[]
  cartItems  CartItem[]
  batchItems ProductionBatchItem[]
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId      String // el pedido entregado que habilita la reseña
  order        Order    @relation(fields: [orderId], references: [id])
  calificacion Int // 1-5
  comentario   String?
  fotoUrl      String?
  aprobada     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([customerId, orderId, productId])
}

// ============================================================
// Cupones
// ============================================================

model Coupon {
  id           String    @id @default(cuid())
  codigo       String    @unique
  tipo         String // "porcentaje" | "monto" | "envio_gratis"
  valor        Decimal   @default(0)
  montoMinimo  Decimal?
  usosMaximos  Int?
  usosActuales Int       @default(0)
  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  orders       Order[]
}

// ============================================================
// Pedidos y pagos
// ============================================================

model Order {
  id              String                   @id @default(cuid())
  numero          Int                      @unique @default(autoincrement())
  customerId      String
  customer        Customer                 @relation(fields: [customerId], references: [id])
  subtotal        Decimal                  @default(0)
  costoEnvio      Decimal                  @default(0)
  descuento       Decimal                  @default(0)
  total           Decimal
  estado          EstadoPedido             @default(Pendiente)
  estadoPago      EstadoPago               @default(PendienteTransferencia)
  canal           CanalVenta               @default(Web)
  metodoEnvio     MetodoEnvio?
  notas           String?
  couponId        String?
  coupon          Coupon?                  @relation(fields: [couponId], references: [id])
  // Pedido generado al aceptar una cotización personalizada del cotizador
  // (merch a medida) — permite calcular la tasa de conversión y mostrar el
  // origen del pedido en la vista interna.
  cotizacionId    String?                  @unique
  cotizacion      CotizacionPersonalizada? @relation(fields: [cotizacionId], references: [id])
  envioNombre     String?
  envioTelefono   String?
  envioCalle      String?
  envioNumero     String?
  envioComuna     String?
  envioRegion     String?
  pagadoAt        DateTime?
  fechaCompromiso DateTime?
  pagoExpiraAt    DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  items           OrderItem[]
  shipment        Shipment?
  payments        Payment[]
  reviews         Review[]
}

model OrderItem {
  id         String                @id @default(cuid())
  orderId    String
  order      Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Ítem de catálogo normal: tiene variantId. Ítem "libre" (viene de una
  // cotización personalizada, sin SKU de catálogo): variantId es null y se
  // usan los campos *Libre para describirlo.
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  descripcionLibre String?
  colorLibre       String?
  tallaLibre       String?
  disenoUrlLibre   String? // diseño de Frente (o único lado)
  disenoEspaldaUrlLibre String? // diseño de Espalda, si la cotización tenía ambos lados
  cantidad   Int
  precioUnit Decimal
  costoUnit  Decimal               @default(0) // snapshot del costo al momento de la venta, para margen
  batchItems ProductionBatchItem[]
}

/// Comprobante de transferencia y su confirmación/rechazo.
model Payment {
  id                 String     @id @default(cuid())
  orderId            String
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  monto              Decimal
  banco              String?
  fechaTransferencia DateTime?
  referencia         String?
  comprobanteUrl     String?
  estado             EstadoPago @default(EnRevision)
  confirmadoPorId    String?
  confirmadoPor      User?      @relation(fields: [confirmadoPorId], references: [id])
  confirmadoAt       DateTime?
  createdAt          DateTime   @default(now())
}

// ============================================================
// Proveedores, insumos y producción
// ============================================================

model Supplier {
  id           String            @id @default(cuid())
  nombre       String
  contacto     String // legado
  email        String?
  telefono     String?
  rut          String?
  tipo         String? // "taller" | "insumos" | "otro"
  tiposProducto TipoProducto[] // qué tipos de producto fabrica/provee (Polera, Poleron, ...) — usado para sugerir proveedor al armar un lote de producción
  leadTimeDias Int
  costoBase    Decimal
  calificacion Int               @default(3)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  batches      ProductionBatch[]
  materials    Material[]
}

model Material {
  id         String             @id @default(cuid())
  nombre     String
  unidad     String // "unidad", "metro", "litro", "kg"
  stock      Decimal            @default(0)
  costo      Decimal            @default(0)
  supplierId String?
  supplier   Supplier?          @relation(fields: [supplierId], references: [id])
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  movements  MaterialMovement[]
}

model MaterialMovement {
  id          String         @id @default(cuid())
  materialId  String
  material    Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  cantidad    Decimal
  tipo        TipoMovimiento
  origen      String
  descripcion String?
  // Costo total pagado en esta compra específica (solo relevante en
  // entradas por compra a proveedor — el precio puede variar entre
  // compras). Permite sumar gasto real por proveedor/período, a
  // diferencia de Material.costo que es un valor de referencia fijo.
  costoTotal  Decimal?
  createdAt   DateTime       @default(now())
}

model ProductionBatch {
  id               String                @id @default(cuid())
  supplierId       String
  supplier         Supplier              @relation(fields: [supplierId], references: [id])
  costoTotal       Decimal
  fechaPedido      DateTime              @default(now())
  fechaEstimada    DateTime
  fechaRecepcion   DateTime?
  estado           EstadoLote            @default(Solicitado)
  // Snapshot del mensaje de WhatsApp enviado al proveedor al crear el
  // pedido (encabezado editable + detalle armado por color/talla/cantidad)
  // — queda guardado para trazabilidad aunque el encabezado no se reuse.
  mensajeWhatsapp  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  items            ProductionBatchItem[]
}

model ProductionBatchItem {
  id            String          @id @default(cuid())
  batchId       String
  batch         ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // Ítem de catálogo: tiene variantId (polera ya cargada como producto).
  // Ítem "on demand" (polera lisa pedida al proveedor sin que exista stock
  // ni variante cargada todavía): variantId es null y se usa color/talla
  // libres — mismo patrón que OrderItem.colorLibre/tallaLibre.
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  colorLibre    String?
  tallaLibre    String?
  orderItemId   String? // vincula el lote a un ítem de pedido pagado (venta bajo pedido)
  orderItem     OrderItem?      @relation(fields: [orderItemId], references: [id])
  cantidad      Int
  costoUnitario Decimal
}

model StockMovement {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  cantidad    Int
  tipo        TipoMovimiento
  origen      String
  descripcion String?
  createdAt   DateTime       @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entidad   String
  entidadId String
  accion    String
  payload   String?
  createdAt DateTime @default(now())
}

// ============================================================
// Envíos
// ============================================================

model Shipment {
  id             String       @id @default(cuid())
  orderId        String       @unique
  order          Order        @relation(fields: [orderId], references: [id])
  metodo         MetodoEnvio?
  trackingNumber String?
  transportista  String?
  costo          Decimal?
  sucursal       String?
  estacionMetro  String?
  horaEntrega    String?
  porPagar       Boolean      @default(false)
  fechaDespacho  DateTime?
  fechaEstimada  DateTime?
  fechaEntrega   DateTime?
  estado         EstadoEnvio  @default(Preparando)
  // Devoluciones — solo se completan cuando estado pasa a Devuelto.
  devolucionMotivo             String?
  devolucionResolucion         ResolucionDevolucion?
  devolucionMontoReembolsado   Decimal?
  devolucionNotas              String?
  devolucionAt                 DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ============================================================
// Marketing y configuración
// ============================================================

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Configuración editable de la tienda — fila única (id fijo "default").
model StoreSettings {
  id                  String   @id @default("default")
  razonSocial         String?
  rut                 String?
  direccionLegal      String?
  emailContacto       String?
  telefonoContacto    String?
  whatsapp            String?
  instagram           String?
  facebook            String?
  tiktok              String?
  horarioAtencion     String?
  bancoTitular        String?
  bancoRut            String?
  bancoNombre         String?
  bancoTipoCuenta     String?
  bancoNumeroCuenta   String?
  bancoEmail          String?
  costoEnvioCorreos   Decimal  @default(3000)
  plazoProduccionDias Int      @default(7)
  // Segundos que cada banner permanece visible antes de avanzar al
  // siguiente en el carrusel del home (autoplay de Splide).
  bannerVelocidadSeg  Int      @default(5)
  updatedAt           DateTime @updatedAt
}

// ============================================================
// Cotizador — prendas personalizables (merch a pedido)
// ============================================================

enum LadoPrenda {
  Frente
  Espalda
}

/// Zona de impresión fija por prenda y lado (cotizador 3D/2D). Una fila = un
/// lado imprimible. Las medidas (anchoCm/altoCm) y los rects 2D se estiman
/// al crearse — se recalibran desde el panel debug (solo dev) cuando se
/// tengan las medidas reales del taller. Ver docs/SPEC-cotizador-3d.md §5.
model PrendaZona {
  id            String     @id @default(cuid())
  prendaBaseId  String
  prendaBase    PrendaBase @relation(fields: [prendaBaseId], references: [id], onDelete: Cascade)
  lado          LadoPrenda

  // Tamaño real imprimible (cm). Define calidad requerida y, a futuro, precio.
  anchoCm       Decimal
  altoCm        Decimal

  // Preview 2D: rectángulo en % del mockup (0–100)
  x2d           Decimal
  y2d           Decimal
  w2d           Decimal
  h2d           Decimal

  // Preview 3D (Decal): posición/rotación en unidades del modelo (Euler, radianes)
  pos3d         Json // [x, y, z]
  rot3d         Json // [x, y, z]
  size3d        Json // [ancho, alto, profundidad de proyección]

  @@unique([prendaBaseId, lado])
}

/// Tipo de prenda que se puede personalizar (Poleras, Polerones, Totebag, Relojes...).
/// Separado de Product porque estas no tienen diseño fijo: el diseño lo trae el cliente.
model PrendaBase {
  id            String        @id @default(cuid())
  nombre        String
  slug          String        @unique
  descripcion   String?
  precioBase    Decimal       @default(0)
  zonaAnchoCm   Decimal? // DEPRECADO — ver PrendaZona. Se mantiene solo por compatibilidad de datos históricos.
  zonaAltoCm    Decimal? // DEPRECADO — ver PrendaZona.
  tallasDisponibles String[] @default([]) // ej: ["S","M","L","XL","2XL"] — vacío si la prenda no usa talla (ej. reloj)
  // Mockup ÚNICO en gris/blanco neutro (fondo transparente): el color de
  // cada variante se aplica encima con CSS (mix-blend-mode), no se necesita
  // una foto distinta por color.
  mockupFrenteUrl String?
  mockupEspaldaUrl String?
  // Modelo 3D (.glb) para el cotizador interactivo — ver docs/SPEC-cotizador-3d.md §6.
  modelo3dUrl   String?
  activa        Boolean       @default(true)
  orden         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  colores       PrendaColor[]
  zonas         PrendaZona[]
  cotizaciones  CotizacionPersonalizada[]
}

/// Color disponible para una prenda base. El mockup vive en PrendaBase — acá
/// solo el nombre y el hex que se aplica sobre ese mockup como tinte.
model PrendaColor {
  id            String     @id @default(cuid())
  prendaBaseId  String
  prendaBase    PrendaBase @relation(fields: [prendaBaseId], references: [id], onDelete: Cascade)
  nombre        String // "Negro", "Blanco", etc.
  hex           String // color real de la tela, aplicado como tinte sobre el mockup
  createdAt     DateTime   @default(now())

  @@unique([prendaBaseId, nombre])
}

/// Solicitud de personalización enviada por un cliente desde /cotizador.
/// No es un Order: se cotiza manualmente (precio variable según diseño/cantidad
/// de estampados) antes de confirmar el pedido real. Al aceptarse, genera un
/// Order vinculado (ver Order.cotizacionId) — permite medir conversión.
model CotizacionPersonalizada {
  id              String           @id @default(cuid())
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  nombreContacto  String
  emailContacto   String
  telefonoContacto String?
  prendaBaseId    String
  prendaBase      PrendaBase       @relation(fields: [prendaBaseId], references: [id])
  colorNombre     String
  talla           String?
  cantidad        Int              @default(1)
  // Diseño del Frente (o Espalda si solo hay espalda) — se mantiene por
  // compatibilidad con admin/email/conversión existentes. El detalle por
  // lado vive en CotizacionDiseno (cotizador 3D).
  disenoUrl       String
  disenos         CotizacionDiseno[]
  notas           String?
  precioCotizado  Decimal?
  estado          EstadoCotizacion @default(Pendiente)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  order           Order?
}

/// Un diseño por lado dentro de una cotización (cotizador 3D). Ver
/// docs/SPEC-cotizador-3d.md §5.
model CotizacionDiseno {
  id            String                  @id @default(cuid())
  cotizacionId  String
  cotizacion    CotizacionPersonalizada @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  lado          LadoPrenda
  disenoUrl     String
  escalaPct     Int                     @default(100) // 50–100
  anchoPx       Int
  altoPx        Int
  previewUrl    String? // snapshot de la composición (CT-13)

  @@unique([cotizacionId, lado])
}

/// Banner del carrusel del home — reemplaza las tarjetas fijas del hero
/// (HeroCards). El admin sube la imagen, define a dónde enlaza y el orden;
/// `activo` permite sacarlo del carrusel sin borrarlo.
model Banner {
  id        String        @id @default(cuid())
  imageUrl  String
  tipo      BannerMedia   @default(Imagen)
  linkUrl   String
  orden     Int           @default(0)
  activo    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([activo, orden])
}

enum BannerMedia {
  Imagen
  Video
}
