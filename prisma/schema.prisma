generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  rol            String          @default("Propietario")
  totpSecret     String?
  totpEnabled    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  auditLogs      AuditLog[]
}

model Customer {
  id                  String    @id @default(cuid())
  nombre              String
  email               String    @unique
  passwordHash        String?
  telefono            String
  direccion           String
  backstagePass       Boolean   @default(false)
  backstagePassExpira DateTime?
  fechaRegistro       DateTime  @default(now())
  totalGastado        Decimal   @default(0)
  orders              Order[]
  cart                Cart?
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  cantidad  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Product {
  id          String   @id @default(cuid())
  nombreSlug  String   @unique
  descripcion String
  disenoUrl   String
  artista     String
  temporada   String
  precio      Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  talle     String
  color     String
  sku       String   @unique
  stock     Int      @default(0)
  stockMin  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orderItems OrderItem[]
  movements StockMovement[]
  cartItems CartItem[]
  batchItems ProductionBatchItem[]
}

model Order {
  id            String      @id @default(cuid())
  numero        Int         @unique @default(autoincrement())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  subtotal      Decimal     @default(0)
  costoEnvio    Decimal     @default(0)
  total         Decimal
  estado        String      @default("Pendiente")
  estadoPago    String      @default("PendienteTransferencia")
  canal         String
  notas         String?
  envioNombre   String?
  envioTelefono String?
  envioCalle    String?
  envioNumero   String?
  envioComuna   String?
  envioRegion   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
  shipment      Shipment?
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  cantidad    Int
  precioUnit  Decimal
}

model Supplier {
  id           String   @id @default(cuid())
  nombre       String
  contacto     String
  leadTimeDias Int
  costoBase    Decimal
  calificacion Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  batches      ProductionBatch[]
}

model ProductionBatch {
  id             String              @id @default(cuid())
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  costoTotal     Decimal
  fechaPedido    DateTime            @default(now())
  fechaEstimada  DateTime
  fechaRecepcion DateTime?
  estado         String              @default("Solicitado")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          ProductionBatchItem[]
}

model ProductionBatchItem {
  id             String         @id @default(cuid())
  batchId        String
  batch          ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  cantidad       Int
  costoUnitario  Decimal
}

model StockMovement {
  id          String         @id @default(cuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  cantidad    Int
  tipo        String
  origen      String
  descripcion String?
  createdAt   DateTime       @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entidad    String
  entidadId  String
  accion     String
  payload    String?
  createdAt  DateTime @default(now())
}

model Shipment {
  id               String   @id @default(cuid())
  orderId          String   @unique
  order            Order    @relation(fields: [orderId], references: [id])
  trackingNumber   String?
  transportista    String?
  costo            Decimal?
  fechaDespacho    DateTime?
  fechaEstimada    DateTime?
  fechaEntrega     DateTime?
  estado           String   @default("Preparando")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
