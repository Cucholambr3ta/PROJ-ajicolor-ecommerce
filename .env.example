# ============================================================
# Variables de entorno — Ajicolor
#
# En Vercel: Settings → Environment Variables. Cada variable de
# abajo indica el tipo que le corresponde en Vercel:
#   - "Secret"        → valor sensible, no se puede volver a ver tras guardar
#   - "Plain/Config"  → valor no sensible (incluye TODO lo que empieza
#                        con NEXT_PUBLIC_, porque esas se embeben en el
#                        JavaScript del navegador — Vercel las rechaza
#                        como Secret)
# ============================================================

# Base de datos (Supabase Postgres) — tipo: Secret
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# NextAuth v5
AUTH_SECRET="genera-un-secret-largo-y-aleatorio"  # tipo: Secret (ej: openssl rand -base64 32)
# Necesario fuera de Vercel (Docker, VPS) para que Auth.js confíe en el host.
AUTH_TRUST_HOST="true"                             # tipo: Plain/Config
AUTH_URL="http://localhost:3000"                   # tipo: Plain/Config — URL real del deploy en producción

# Login con Google (Fase 4 — pendiente de credenciales del dueño de marca) — tipo: Secret
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Emails transaccionales (Fase 5 — Resend)
RESEND_API_KEY=""                                  # tipo: Secret
EMAIL_FROM="Ajicolor <no-responder@tudominio.cl>"  # tipo: Plain/Config

# Supabase Storage (Fase 6 — subida de imágenes de producto y comprobantes de pago) — tipo: Secret
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# URL pública del sitio (sitemap, robots, emails, OG images) — tipo: Plain/Config
# IMPORTANTE: no marcar como "Secret" en Vercel — al empezar con NEXT_PUBLIC_,
# Vercel exige que sea Plain/Config porque el valor viaja al navegador.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
